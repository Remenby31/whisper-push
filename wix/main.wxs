<?xml version='1.0' encoding='windows-1252'?>
<!--
  Whisper Push MSI, built by `cargo wix` (cargo-wix, Apache-2.0; this file
  started as its generated template).

  What this installer must do, because the app has no window of its own:

    * Install WITHOUT a UAC prompt. `InstallScope='perUser'` into
      %LOCALAPPDATA%\Programs — a consumer dictation app has no business
      asking for administrator rights, and a per-user install is also what
      lets the in-app updater replace files later.
    * Leave a Start Menu shortcut. It is the only way to launch the app after
      the first run, and it carries `System.AppUserModel.ID`, which is what
      makes Windows attribute the app's toast notifications to Whisper Push
      instead of to PowerShell.
    * Offer "Launch Whisper Push" on the last page, ticked. The first launch
      runs the setup wizard (models, permissions, hotkey); until it runs, the
      user has installed something that appears to do nothing.
    * NOT write the autostart registry value. `src/autostart.rs` owns that key
      (the wizard's "Launch at login" toggle writes it); two owners means a
      repair or reinstall silently re-enables something the user turned off.

  Variables `cargo wix` supplies: CargoTargetBinDir, Version, Profile, …
-->

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'
     xmlns:util='http://schemas.microsoft.com/wix/UtilExtension'>

    <Product
        Id='*'
        Name='Whisper Push'
        UpgradeCode='8B7E1C2D-3F4A-4B5C-9D6E-7F8A9B0C1D2E'
        Manufacturer='Whisper Push'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <!-- InstallerVersion 500 = Windows Installer 5.0, required by the
             MsiShortcutProperty table behind the shortcut's AppUserModel.ID.
             InstallScope perUser = no UAC prompt, everything under HKCU and
             %LOCALAPPDATA%; WiX derives ALLUSERS/MSIINSTALLPERUSER from it, so
             declaring those by hand would collide. -->
        <Package Id='*'
            Keywords='Installer'
            Description='Push-to-talk voice dictation, 100% local. Hold a key, speak, release — your words are typed wherever your cursor is.'
            Manufacturer='Whisper Push'
            InstallerVersion='500'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Whisper Push Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <!-- %LOCALAPPDATA%\Programs\Whisper Push -->
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='ProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='Whisper Push'>
                        <Component Id='License' Guid='*'>
                            <File Id='LicenseFile' DiskId='1' Source='LICENSE' KeyPath='yes'/>
                        </Component>

                        <Directory Id='Bin' Name='bin'>
                            <!-- The user's PATH, not the machine's: a per-user
                                 install can't write the system environment. -->
                            <Component Id='Path' Guid='9C8F2D3E-4A5B-4C6D-AE7F-8B9C0D1E2F30' KeyPath='yes'>
                                <Environment
                                    Id='PATH'
                                    Name='PATH'
                                    Value='[Bin]'
                                    Permanent='no'
                                    Part='last'
                                    Action='set'
                                    System='no'/>
                            </Component>
                            <Component Id='binary0' Guid='*'>
                                <File
                                    Id='exe0'
                                    Name='whisper-push.exe'
                                    DiskId='1'
                                    Source='$(var.CargoTargetBinDir)\whisper-push.exe'
                                    KeyPath='yes'/>
                            </Component>
                            <!--
                              The whisper-push-test E2E harness binary is intentionally
                              NOT shipped: it's a macOS/metal-only test tool and isn't
                              built on Windows, so including it breaks the MSI link.
                            -->
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu entry. Without it the app is unlaunchable after the
                 first run unless the user types a command, which is exactly the
                 experience this installer exists to remove. -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='AppShortcutFolder' Name='Whisper Push'>
                    <Component Id='StartMenuShortcut' Guid='4E1C9A77-6B2D-4E58-9F14-2A8B7C3D5E61'>
                        <Shortcut Id='StartMenuApp'
                            Name='Whisper Push'
                            Description='Push-to-talk voice dictation, 100% local'
                            Target='[#exe0]'
                            WorkingDirectory='Bin'
                            Icon='ProductICO'>
                            <!-- Ties toast notifications to our identity; the
                                 daemon claims the same id at startup (see
                                 src/tray/windows_shell.rs). -->
                            <ShortcutProperty Key='System.AppUserModel.ID' Value='com.whisper-push.app'/>
                        </Shortcut>
                        <RemoveFolder Id='RemoveAppShortcutFolder' Directory='AppShortcutFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU'
                            Key='Software\Whisper Push'
                            Name='StartMenuShortcut'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs Whisper Push and its Start Menu shortcut.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='StartMenuShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add Whisper Push to your PATH so `whisper-push` works from any terminal.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='wix\whisper-push.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>
        <Property Id='ARPHELPLINK' Value='https://whisperpush.com'/>

        <!-- ── Launch on the last page ────────────────────────────────────────
             The first launch is what runs the setup wizard, so the default is
             ticked: a fresh install that leaves nothing running looks broken.
             `WixShellExec` runs it as the *user*, not as the installer, which
             matters for a per-user app (and for the tray icon to belong to the
             right session). -->
        <Property Id='WixShellExecTarget' Value='[#exe0]'/>
        <CustomAction Id='LaunchApplication'
            BinaryKey='WixCA'
            DllEntry='WixShellExec'
            Impersonate='yes'
            Return='asyncNoWait'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>

            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>

            <Publish Dialog='ExitDialog'
                Control='Finish'
                Event='DoAction'
                Value='LaunchApplication'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='Launch Whisper Push'/>
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1'/>

    </Product>

</Wix>
