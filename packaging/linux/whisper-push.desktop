[Desktop Entry]
Type=Application
Name=Whisper Push
GenericName=Voice Dictation
Comment=Push-to-talk voice dictation, 100% local
Exec=whisper-push
Icon=whisper-push
Terminal=false
# The app has no window of its own: it lives in the tray, so the launcher must
# not wait for one (StartupNotify=true left the cursor spinning for 30 s).
StartupNotify=false
Categories=AudioVideo;Audio;Utility;
Keywords=dictation;voice;speech;whisper;transcription;
X-GNOME-UsesNotifications=true
